; Rows.inc - the pool of app row slots. Mixer.lua fills and shows or hides them.
; Generated by tools\generate-rows.ps1: the rows are identical except for their number and position.
; Every position comes from the layout file in use (Layout-full.inc or Layout-compact.inc).

; ---------- Row 1 ----------

[R1Tile]
Meter=Shape
MeterStyle=StTile
Y=((#RowsTop#+0*#RowH#+#TileY#)*#Scale#)
Shape=Rectangle 0,0,(#TileSize#*#Scale#),(#TileSize#*#Scale#),(#TileSize#/4*#Scale#) | Fill Color #R1Tile# | StrokeWidth 0
Group=R1Tile

[R1Letter]
Meter=String
MeterStyle=StLetter
Y=((#RowsTop#+0*#RowH#+#LetterY#)*#Scale#)
Group=R1Tile

[R1Img]
Meter=Image
MeterStyle=StImg
Y=((#RowsTop#+0*#RowH#+#ImgY#)*#Scale#)
Group=R1Img

; Pin button (gutter, top): grey and translucent when the app is not pinned, bright when it is. Mixer.lua sets the color.
[R1PinGlyph]
Meter=String
MeterStyle=StPinGlyph
Text=#IconPin#
Y=((#RowsTop#+0*#RowH#+#PinGlyphY#)*#Scale#)
Group=R1Pin

[R1PinHit]
Meter=Shape
MeterStyle=StGutterHit
Y=((#RowsTop#+0*#RowH#+#PinHitY#)*#Scale#)
Shape=Rectangle 0,0,(#Gutter#*#Scale#),(#PinHitH#*#Scale#) | Fill Color 0,0,0,1 | StrokeWidth 0
MouseOverAction=[!CommandMeasure Mixer "PinHover(1,1)"]
MouseLeaveAction=[!CommandMeasure Mixer "PinHover(1,0)"]
LeftMouseDownAction=[!CommandMeasure Mixer "Down('pin',1)"]
LeftMouseUpAction=[!CommandMeasure Mixer "Click('pin',1)"]
Group=R1Pin

; Reorder grip (gutter, below the pin): faint, a little more visible on hover. Dragging it moves the app inside its group.
[R1Grab]
Meter=Shape
MeterStyle=StGutterHit
Y=((#RowsTop#+0*#RowH#+#GrabY#)*#Scale#)
Shape=Rectangle 0,0,(#Gutter#*#Scale#),(#GrabHitH#*#Scale#) | Fill Color 0,0,0,1 | StrokeWidth 0
Shape2=Rectangle ((#Gutter#-#GrabBarW#)/2*#Scale#),((#GrabHitH#-#GrabBarH#)/2*#Scale#),(#GrabBarW#*#Scale#),(#GrabBarH#*#Scale#),(3*#Scale#) | Fill Color #R1Grab# | StrokeWidth 0
MouseOverAction=[!CommandMeasure Mixer "GrabHover(1,1)"]
MouseLeaveAction=[!CommandMeasure Mixer "GrabHover(1,0)"]
LeftMouseDownAction=[!CommandMeasure Mixer "Reorder(1)"]
Group=R1Grab

[R1Name]
Meter=String
MeterStyle=StName
Y=((#RowsTop#+0*#RowH#+#NameY#)*#Scale#)
MouseScrollUpAction=[!CommandMeasure Mixer "Wheel(1,1)"]
MouseScrollDownAction=[!CommandMeasure Mixer "Wheel(1,-1)"]
Group=R1

[R1Percent]
Meter=String
MeterStyle=StPercent
Y=((#RowsTop#+0*#RowH#+#PercentY#)*#Scale#)
MouseScrollUpAction=[!CommandMeasure Mixer "Wheel(1,1)"]
MouseScrollDownAction=[!CommandMeasure Mixer "Wheel(1,-1)"]
Group=R1

[R1Slider]
Meter=Shape
MeterStyle=StSlider
Y=((#RowsTop#+0*#RowH#+#SliderY#)*#Scale#)
Shape=Rectangle 0,0,(#SliderW#*#Scale#),(6*#Scale#),(3*#Scale#) | Fill Color #R1Track# | StrokeWidth 0
Shape2=Rectangle 0,0,(#SliderW#*#Scale#*#R1Vol#/100),(6*#Scale#),(3*#Scale#) | Fill Color #R1Fill# | StrokeWidth 0
Shape3=Ellipse (#SliderW#*#Scale#*#R1Vol#/100),(3*#Scale#),(7*#Scale#) | Fill Color #R1Thumb# | StrokeWidth 0
Group=R1

; Invisible hit area over the track: a press sets the value, the helper then follows the drag.
[R1Hit]
Meter=Shape
MeterStyle=StHit
Y=((#RowsTop#+0*#RowH#+#HitY#)*#Scale#)
LeftMouseDownAction=[!CommandMeasure Mixer "Press(1,$MouseX:%$)"]
MouseScrollUpAction=[!CommandMeasure Mixer "Wheel(1,1)"]
MouseScrollDownAction=[!CommandMeasure Mixer "Wheel(1,-1)"]
Group=R1Hit

[R1Mute]
Meter=String
MeterStyle=StMute
Y=((#RowsTop#+0*#RowH#+#MuteY#)*#Scale#)
LeftMouseDownAction=[!CommandMeasure Mixer "Down('mute',1)"]
LeftMouseUpAction=[!CommandMeasure Mixer "Click('mute',1)"]
MouseLeaveAction=[!CommandMeasure Mixer "Cancel()"]
Group=R1

